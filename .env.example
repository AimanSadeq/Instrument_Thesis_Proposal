# Copy to .env for local work, or set these in the Render dashboard.
# Nothing here is a participant identity; nothing here is stored in a row.

# Supabase connection string (direct Postgres, not the REST API).
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# verify (default, system CAs) | ca (pin DATABASE_CA_CERT) | disable (local only)
DATABASE_SSL=verify
# Path to, or contents of, the Supabase CA certificate when DATABASE_SSL=ca.
DATABASE_CA_CERT=

# The calendar date stored on each row is computed in this zone. Date only.
COLLECTION_TIMEZONE=Asia/Riyadh

# Stamped on every row. Change to cohort-2 before the October programme.
COHORT=cohort-1

# Facilitator secret: counts only, never response contents.
ADMIN_SECRET=
# Researcher secret: export and delete. Must differ from ADMIN_SECRET, and the
# facilitator must not hold it.
EXPORT_SECRET=

# Set false outside the collection window to refuse submissions with a clear
# message instead of accepting stray data.
INSTRUMENTS_OPEN=true

# Used only to print links and QR codes on the admin page.
PUBLIC_URL=https://example.onrender.com

PORT=3000
